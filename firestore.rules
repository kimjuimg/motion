rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // moods/{YYYY-MM-DD}/entries/{학생키}
    match /moods/{dateKey}/entries/{entryId} {

      // 익명 로그인한 사용자만 읽고 쓸 수 있습니다.
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['name', 'code', 'emotionId', 'reason', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 40
        && request.resource.data.emotionId is string
        && request.resource.data.emotionId.size() <= 20
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200;

      // 학생이 남의 기록을 지울 수 없게 막습니다.
      // 정리는 Firebase 콘솔에서 선생님이 직접 하세요.
      allow delete: if false;
    }

    // 그 밖의 모든 경로는 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
