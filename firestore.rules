rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // moods/{YYYY-MM-DD}/entries/{학생키}
    match /moods/{dateKey}/entries/{entryId} {

      // 익명 로그인한 사용자만 읽고 쓸 수 있습니다.
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['name', 'code', 'emotionId', 'reason', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 40
        && request.resource.data.emotionId is string
        && request.resource.data.emotionId.size() <= 20
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200;

      // 선생님이 화면에서 기록을 지울 수 있도록 삭제를 허용합니다.
      //
      // ⚠️ 이 규칙은 "선생님만" 을 구분하지 못합니다. 모두가 익명 로그인이라
      // 서버는 교사와 학생을 알아볼 방법이 없고, 교사 코드는 브라우저 안에만
      // 있는 칸막이일 뿐입니다. 즉 주소를 알고 개발자 도구를 열 줄 아는
      // 학생이라면 남의 기록도 지울 수 있습니다.
      //
      // 진짜로 막아야 한다면 Authentication 에 교사 이메일 계정을 만들고
      //   allow delete: if request.auth.token.email in ['teacher@school.kr'];
      // 처럼 계정을 확인하도록 바꿔야 합니다.
      allow delete: if request.auth != null;
    }

    // classes/{학급키} — 선생님이 만드는 학급 목록
    match /classes/{classId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'code', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 40;

      // 학급 목록은 선생님이 화면에서 지울 수 있어야 하므로 삭제를 허용합니다.
      // 쪽지(entries)와 달리 언제든 다시 만들 수 있는 설정값입니다.
      allow delete: if request.auth != null;
    }

    // 그 밖의 모든 경로는 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
